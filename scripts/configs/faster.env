# Faster-SelfForcing: the 17 environment switches of the measured configuration (round R08, 2.08x).
# Every switch is off unless set here. FlashAttention-3 is on by default (SF_ATTN=fa2 restores the upstream FA2 path);
# Recorded FA2 tests matched the reference tensors; the historical FA3 configuration passed its statistical check.
# Usage: source scripts/configs/faster.env
export SF_EMA_FAST=1           # EMA without per-parameter synchronous copies
export SF_EMA_ASYNC=1          # EMA CPU update in a background thread
export SF_NO_SYNC=1            # no host synchronisation in the rollout
export SF_ROPE_FUSED=1         # fused rotary embedding
export SF_SAC=1                # selective activation checkpointing: keep attention outputs
export SF_SAC_SAVE=ffn2,o,co   # also keep these linear outputs (bidirectional models only)
export SF_COMPILE=1            # compiled pointwise chains (bit-exact)
export SF_COMPILE_MIN_TOKENS=16384
export SF_FSDP_HOLD=1          # all-gather the generator once per rollout
export SF_XATTN_CACHE=1        # cross-attention K/V computed once per rollout
export SF_CUDAGRAPH=1          # CUDA graphs for the no-grad KV-cache forwards (needs SF_NO_SYNC and SF_FSDP_HOLD)
export SF_FUSE_EW=1            # Triton RMSNorm and rollout-size modulate / gated residual
export SF_EW_LONG=1            # Triton modulate / gated residual at every size
export SF_FUSE_QKROPE=1        # q/k RMSNorm + RoPE in one kernel
export SF_FUSE_LNMOD=1         # LayerNorm + modulate in one kernel
export SF_FROZEN_BF16=1        # frozen teacher and text encoder held in BF16
export SF_T5_RESIDENT=1        # text encoder all-gathered once and kept
